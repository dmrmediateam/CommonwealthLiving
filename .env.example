# ==========================================================================
# Copy to .env.local and fill in. Never commit real keys.
#
# This file is gitignored: never commit real keys. The same values go in the
# Vercel project (Settings -> Environment Variables) for production.
# Restart `npm run dev` after editing; Next.js reads this only at boot.
# ==========================================================================

# ---- IDX Broker ----------------------------------------------------------
# Sign up at idxbroker.com, then Account -> API Keys. Until IDX_API_KEY is
# set, /listings falls back to the DEMO- placeholder listings in
# content/site.ts and the site still builds.
IDX_API_KEY=
# Optional partner/ancillary key: higher rate limits and listing detail access.
IDX_ANCILLARY_KEY=

# Cached browse pool: the towns the search warms up with. Ordered, because the
# first six are the fast-fallback set when the pool is cold.
IDX_MARKET_CITIES=Canton,Westwood,Wellesley,Needham,Newton,Boston

# Comma-separated IDX office id(s) that mark listings as "ours" (the homepage
# featured band). Find it in IDX Broker under Agents/Offices; ask Tom's broker
# for the Real Broker MA office id if the team's listings are filed under it.
IDX_OFFICE_IDS=

# ---- Lead delivery -------------------------------------------------------
# Without these, leads are only logged as "[Lead] NOT DELIVERED". Set them in
# Vercel before launch or every paid lead is lost.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
LEAD_NOTIFY_EMAIL=
# Optional: SMS alerts to Tom's cell, and a CRM (Follow Up Boss) webhook.
LEAD_NOTIFY_SMS=
LEAD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Analytics -----------------------------------------------------------
# Not secrets (they ship in page source). The Google Ads *conversion* id looks
# like AW-XXXXXXXXX and is not the account/customer id (439-960-2347).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
